import { useState } from "react";

const Counter = () => {
    const [count, setCount] = useState(0);
  
    const handleClick = () => {
      setTimeout(() => {
        setCount(prev => prev + 1);
      }, 1000);
  
      setTimeout(() => {
        setCount(prev => prev + 1);
      }, 2000);
    };
  
    return (
      <>
        <h2>{count}</h2>
        <button onClick={handleClick}>Start</button>
      </>
    );
  };

export default Counter;

