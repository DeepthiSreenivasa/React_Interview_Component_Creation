import { useState } from "react";

const Counter = () => {
    const [count, setCount] = useState(0);
  
    const handleClick = () => {
      setCount(count + 1);
  
      setTimeout(() => {
        setCount(count + 2);
      }, 1000);
    };
  
    return (
      <>
        <h2>{count}</h2>
        <button onClick={handleClick}>Increase</button>
      </>
    );
  };

export default Counter;

