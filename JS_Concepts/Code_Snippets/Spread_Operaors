const state = {
    cart: {
        items: [
            {
                id: 1,
                name: "Laptop",
                quantity: 1,
                pricing: {
                    price: 1000,
                    currency: "USD"
                }
            },
            {
                id: 2,
                name: "Phone",
                quantity: 2,
                pricing: {
                    price: 500,
                    currency: "USD"
                }
            }
        ],
        totalItems: 3,
        totalPrice: 2000
    },
    user: {
        name: "Deepthi"
    }
};

const updateItems = state.cart.items.map(item => { if (item.id == 2) { return { ...item, quantity: 3, pricing: { ...item.pricing, price: 550 } } } else { return item } })

console.log("updateItems::", updateItems)

const newState = {
    ...state,cart:{...state.cart,items:updateItems,totalItems:4},user:{...state.user,name:"Deepthi Sreenivasa"}
}

console.log("New State::",newState)


